---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/theme.css';
import { Code } from 'astro:components';
import logo from '../assets/logo.svg?raw';
import Icon from '../components/Icon.astro';
import { githubIcon, installIcon, languageIcon } from '../lib/icons';
import { agentPrompt, installs, languages, license, pluginInstall, validators, version } from '../lib/repo';

const title = 'blockwatch: keep code, docs and configs in sync';
const description = `Write a rule in a comment next to the code. When a change breaks it, your pre-commit hook or CI fails. ${languages.length} languages, free and open source.`;

// One short example per validator, shown on its card. The names must be the ones in the README's validator table; a
// validator without an example here gets a card with its description only.
const examples: Record<string, { lang: 'python' | 'javascript' | 'html'; code: string }> = {
	affects: {
		lang: 'python',
		code: `# <block
#   affects="README.md:login">
def login(user, password):
    ...
# </block>`,
	},
	'same-as': {
		lang: 'python',
		code: `# <block
#   same-as="app.json#/port"
#   same-as-pattern="\\d+">
PORT = 8080
# </block>`,
	},
	'keep-sorted': {
		lang: 'python',
		code: `# <block keep-sorted="asc">
"billing",
"search",
"users",
# </block>`,
	},
	'keep-unique': {
		lang: 'javascript',
		code: `// <block keep-unique>
"user_1",
"user_2",
// </block>`,
	},
	'line-pattern': {
		lang: 'python',
		code: `# <block
#   line-pattern='^"[a-z-]+"'>
"valid-slug",
"another-one",
# </block>`,
	},
	'line-count': {
		lang: 'python',
		code: `# <block line-count="<=5">
"a",
"b",
# </block>`,
	},
	'check-ai': {
		lang: 'html',
		code: `<!-- <block check-ai="Must mention 'Acme Corp'"> -->
<p>Welcome to Acme Corp!</p>
<!-- </block> -->`,
	},
	'check-lua': {
		lang: 'python',
		code: `# <block
#   check-lua="colors.lua">
'red',
'green',
# </block>`,
	},
};

const faq = [
	{
		q: 'Does it need Git?',
		short: 'No',
		a: 'No. A plain <code>blockwatch</code> run checks every block in the folder. Rules such as <code class="tk-k">affects</code> need to know what changed, so they read a unified diff from stdin. Git, Mercurial and Jujutsu all print one.',
	},
	{
		q: 'Does it send my code anywhere?',
		short: 'No',
		a: 'No. blockwatch runs on your machine. The one exception is opt-in: a block you mark with <code class="tk-k">check-ai</code> sends its text to the AI API you set up for it.',
	},
	{
		q: 'Which languages does it read?',
		short: `${languages.length}`,
		a: `${languages.length} languages and formats, from Python and Rust to YAML, Markdown and Dockerfiles. A file that can't hold a comment, such as JSON, gets its rules from <code class="tk-s">blockwatch.toml</code>.`,
	},
	{
		q: 'Do I have to write the blocks myself?',
		short: 'No',
		a: 'No. blockwatch ships a skill for coding agents. Paste one prompt, and the agent finds the places that must stay in sync and adds the blocks. You review them like any other change.',
	},
	{
		q: 'Is it free?',
		short: 'Yes',
		a: 'Yes. blockwatch is open source under the MIT license.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<script is:inline>
			// Starlight saves the reader's theme choice under this key, so the landing page follows the docs.
			try {
				const saved = localStorage.getItem('starlight-theme');
				const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme = dark ? 'dark' : 'light';
			} catch {
				document.documentElement.dataset.theme = 'dark';
			}
		</script>
	</head>
	<body>
		<header class="top">
			<div class="brand-row">
				<a class="brand" href="/"><span class="logo" set:html={logo} />blockwatch</a>
				<p class="badge"><span class="badge-long">Free, open source, {license} licensed · </span>v{version}</p>
			</div>
			<nav>
				<a href="/docs/">Docs</a>
				<a class="github" href="https://github.com/mennanov/blockwatch" aria-label="blockwatch on GitHub"
					><Icon icon={githubIcon} />GitHub</a
				>
			</nav>
		</header>

		<main>
			<section class="hero wrap">
				<h1>Catch drift before it ships</h1>
				<p class="lead">
					Some values have to change together: a port in three configs, a version in the docs, a constant and the
					test that checks it. Write those rules in comments. When a change breaks one, your pre-commit hook or CI
					fails.
				</p>
				<div class="actions">
					<a class="button primary" href="#install" data-event="install-click">Install</a>
					<a class="button" href="/docs/">Read the docs</a>
					<a class="button" href="https://github.com/mennanov/blockwatch" data-event="github-click"
						><Icon icon={githubIcon} />View on GitHub</a
					>
				</div>

				<div class="demo" data-step="3" role="group" aria-label="Animated example: a changed port fails the commit">
					<ol class="demo-tabs">
						{
							['Same values in 3 files','One file changes', 'The commit fails', 'Fix both, and it passes'].map(
								(label, i) => (
									<li>
										<button data-goto={i + 1} aria-current={i === 2 ? 'step' : undefined} data-done={i < 2 ? '' : undefined}>
											<span class="tab-n">{i + 1}</span>
											<span class="tab-label">{label}</span>
										</button>
									</li>
								),
							)
						}
					</ol>
					<p class="tab-phone-label" aria-hidden="true" data-phone-label>The commit fails</p>
					<div class="demo-files">
						<figure class="file" data-focus="1 2">
							<figcaption>app/settings.py</figcaption>
							<pre><code>HOST <span class="tk-k">=</span> <span class="tk-s">"0.0.0.0"</span>
PORT <span class="tk-k">=</span> <span class="val src" data-src>9090</span><span class="caret"></span></code></pre>
						</figure>
						<div class="dependents" data-focus="4">
						<figure class="file" data-focus="1">
							<figcaption>Dockerfile</figcaption>
							<pre><code><span class="tk-k">FROM</span> python:3.13-slim
<span class="tk-c"># &lt;block
#   same-as="app/settings.py#/PORT"
#   same-as-pattern="\d+"&gt;</span>
<span class="tk-k">EXPOSE</span> <span class="val dep" data-dep>8080</span><span class="caret"></span>
<span class="tk-c"># &lt;/block&gt;</span></code></pre>
						</figure>
						<figure class="file" data-focus="1">
							<figcaption>deploy.json</figcaption>
							<pre><code>{"{"} <span class="tk-k">"port"</span><span class="tk-p">:</span> <span class="val dep" data-dep>8080</span><span class="caret"></span> {"}"}</code></pre>
							<div class="rule-file">
								<p class="rule-caption">blockwatch.toml</p>
								<pre><code><span class="tk-p">[[</span>block<span class="tk-p">]]</span>
target <span class="tk-k">=</span> <span class="tk-s">'deploy.json#/port'</span>
same-as <span class="tk-k">=</span> <span class="tk-s">'app/settings.py#/PORT'</span></code></pre>
							</div>
						</figure>
						</div>
						<figure class="terminal" data-focus="3 4-commit">
							<pre><code><span class="prompt">$</span> <span class="caret t-idle"></span><span class="t-run"><span class="tk-f">git</span> <span class="tk-s">commit</span></span><span class="t-out"><span class="t-block t-fail"><span style="--i: 1"><span class="fail">✗</span> blockwatch<sup>*</sup></span><span style="--i: 2">  Dockerfile   <span class="fail">8080 ≠ 9090</span></span><span style="--i: 3">  deploy.json  <span class="fail">8080 ≠ 9090</span></span></span><span class="t-block t-pass"><span style="--i: 1"><span class="ok">✓</span> blockwatch<sup>*</sup></span></span></span></code></pre>
						</figure>
						<div class="focus-ring" aria-hidden="true"></div>
						<div class="focus-ring" aria-hidden="true"></div>
						<div class="focus-ring" aria-hidden="true"></div>
						<svg class="links" aria-hidden="true">
							<mask id="links-mask" maskUnits="userSpaceOnUse" />
							<mask id="halo-mask" maskUnits="userSpaceOnUse" />
							<g mask="url(#halo-mask)"><path class="halo" pathLength="1" /><path class="halo" pathLength="1" /></g>
							<g mask="url(#links-mask)"><path class="curve" pathLength="1" /><path class="curve" pathLength="1" /></g>
						</svg>
					</div>
				</div>
				<p class="note">
					* A simplified demo. blockwatch prints its findings as JSON. <a href="/docs/#how-it-works">See the real output.</a>
				</p>
			</section>

			<section id="install" class="wrap">
				<h2><span class="hash">#</span> Quick start</h2>
				<ol class="steps">
					<li>
						<h3>Install blockwatch</h3>
						<div class="tabs" role="tablist">
							{
								installs.map((install, i) => (
									<button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>
										<Icon icon={installIcon(install.label)} />
										{install.label}
									</button>
								))
							}
						</div>
						<div class="install-panels">
						{
							installs.map((install, i) => (
								<div class="copy-box" data-panel={i} hidden={i !== 0}>
									<Code code={install.command} lang="shell" theme="css-variables" />
									<button class="copy" data-copy={install.command} data-event={`copy-install-${install.label.toLowerCase()}`}>
										Copy
									</button>
								</div>
							))
						}
						</div>
					</li>
					<li>
						<h3>Let your coding agent add the blocks</h3>
						<p>Paste this prompt into Claude Code, Codex, Cursor or any other agent:</p>
						<div class="copy-box prompt-box">
							<code>{agentPrompt}</code>
							<button class="copy" data-copy={agentPrompt} data-event="copy-agent-prompt">Copy</button>
						</div>
						<p class="muted">
							Review the blocks it adds and commit them. The skill stays in the project, so later agents know the rules
							too. <a href="/docs/agents/">Other agent setups</a>
						</p>
					</li>
					<li>
						<h3>Check every commit</h3>
						<div class="two">
							<figure class="file">
								<figcaption>.pre-commit-config.yaml</figcaption>
								<Code
									code={`- repo: https://github.com/mennanov/blockwatch
  rev: v${version}
  hooks:
    - id: blockwatch`}
									lang="yaml"
									theme="css-variables"
								/>
							</figure>
							<figure class="file">
								<figcaption>GitHub Actions</figcaption>
								<Code code="- uses: mennanov/blockwatch-action@v1" lang="yaml" theme="css-variables" />
							</figure>
						</div>
						<p class="muted"><a href="/docs/ci/">Plain Git hooks, other CI and SARIF output</a></p>
					</li>
				</ol>
			</section>

			<section class="wrap">
				<h2><span class="hash">#</span> How it works</h2>
				<div class="split">
					<ul class="facts">
						<li>A <strong>block</strong> is a pair of tags in comments, around the lines a rule covers.</li>
						<li>The <strong>start tag</strong> holds the rules, such as <code class="tk-k">same-as</code> or <code class="tk-k">keep-sorted</code>.</li>
						<li>
							A rule can point at another block, a whole file, or a <a href="/docs/symbols/">symbol</a>: a constant in
							code, a key in JSON or YAML, a Markdown section.
						</li>
						<li>
							A file that can't hold a comment, such as <code class="tk-s">package.json</code>, gets its blocks
							from <code class="tk-s">blockwatch.toml</code>.
						</li>
						<li>
							<code>blockwatch</code> checks the whole repository. <code><span class="tk-f">git</span> <span class="tk-s">diff --patch</span> <span class="tk-k">|</span> <span class="tk-f">blockwatch</span> <span class="tk-s">--diff</span></code> also
							checks the rules that need a change.
						</li>
					</ul>
					<figure class="file">
						<figcaption>blockwatch.toml</figcaption>
						<Code
							code={`# deploy.json can't hold a comment,
# so its block is declared here.
[[block]]
target = 'deploy.json#/port'
same-as = 'app/settings.py#/PORT'`}
							lang="toml"
							theme="css-variables"
						/>
					</figure>
				</div>
			</section>

			<section class="wrap">
				<h2><span class="hash">#</span> {validators.length} validators</h2>
				<p class="section-lead">
					Two work across files. The rest check one block on its own: the things you would otherwise point out in code
					review.
				</p>
				<div class="grid">
					{
						validators.map((validator) => (
							<a class="card" href={`/docs/validators/${validator.name}/`}>
								<h3>
									<code>{validator.name}</code>
								</h3>
								<p>{validator.description}</p>
								{examples[validator.name] && (
									<Code
										code={examples[validator.name].code}
										lang={examples[validator.name].lang}
										theme="css-variables"
										wrap
									/>
								)}
							</a>
						))
					}
				</div>
			</section>

			<section class="wrap">
				<h2><span class="hash">#</span> {languages.length} languages</h2>
				<p class="section-lead">
					blockwatch reads the comments of each language with a real parser, so a tag inside a string is not a block.
				</p>
				<ul class="languages">
					{
						languages.map((language) => (
							<li>
								<Icon icon={languageIcon(language)} />
								{language}
							</li>
						))
					}
				</ul>
			</section>

			<section class="wrap">
				<h2><span class="hash">#</span> Made for coding agents</h2>
				<div class="split">
					<ul class="facts">
						<li>
							Agents edit one file and miss the other three that depend on it. Code review catches some of that. A failed
							commit catches all of it.
						</li>
						<li>
							<code><span class="tk-f">blockwatch</span> <span class="tk-s">skill</span></code> prints a skill that tells an agent where blocks make sense and how to write
							them.
						</li>
						<li>The skill stays in the project. Every agent that works on it later reads the same rules.</li>
						<li>
							The skill runs <code><span class="tk-f">blockwatch</span> <span class="tk-s">skill</span></code> each time it loads, so it always matches the installed
							version.
						</li>
					</ul>
					<figure class="terminal">
						<figcaption><span></span><span></span><span></span></figcaption>
						<pre><code>{pluginInstall.map((line) => { const words = line.split(' '); return <Fragment><span class="prompt">&gt;</span> <span class="tk-k">{words[0]}</span>{` ${words.slice(1, -1).join(' ')} `}<span class="tk-s">{words.at(-1)}</span>{'\n'}</Fragment>; })}
<span class="tk-c"># Claude Code now knows when to add
# a block, and checks its own work.</span></code></pre>
					</figure>
				</div>
			</section>

			<section class="wrap">
				<h2><span class="hash">#</span> FAQ</h2>
				<div class="faq">
					{
						faq.map((item) => (
							<details>
								<summary>
									{item.q}
									<span class="short">{item.short}</span>
								</summary>
								<p set:html={item.a} />
							</details>
						))
					}
				</div>
			</section>

			<section class="wrap final">
				<h2>Catch the files you forgot to change</h2>
				<p class="section-lead">Install blockwatch, then let your agent add the first blocks.</p>
				<div class="actions">
					<a class="button primary" href="#install" data-event="install-click-bottom">Install</a>
					<a class="button" href="/docs/">Read the docs</a>
					<a class="button" href="https://github.com/mennanov/blockwatch" data-event="github-click-bottom"
						><Icon icon={githubIcon} />View on GitHub</a
					>
				</div>
			</section>
		</main>

		<footer class="wrap">
			<span>MIT license</span>
			<a href="https://github.com/mennanov/blockwatch">GitHub</a>
			<a href="https://crates.io/crates/blockwatch">crates.io</a>
			<a href="https://github.com/mennanov/blockwatch/blob/main/CHANGELOG.md">Changelog</a>
		</footer>

		<script>
			for (const tab of document.querySelectorAll<HTMLButtonElement>('[data-tab]')) {
				tab.addEventListener('click', () => {
					for (const other of document.querySelectorAll('[data-tab]')) {
						other.setAttribute('aria-selected', String(other === tab));
					}
					for (const panel of document.querySelectorAll<HTMLElement>('[data-panel]')) {
						panel.hidden = panel.dataset.panel !== tab.dataset.tab;
					}
				});
			}
			for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
				button.addEventListener('click', async () => {
					await navigator.clipboard.writeText(button.dataset.copy ?? '');
					button.textContent = 'Copied';
					setTimeout(() => (button.textContent = 'Copy'), 1500);
				});
			}
			setupDemo();

			/**
			 * Plays the hero example one step at a time, in a loop, once it scrolls into view. A click on a tab plays that
			 * step the same way, then stops the loop there, so the reader can go at their own pace. With reduced motion,
			 * the page keeps the failed commit that the HTML shows, and a click shows a step's end state.
			 */
			function setupDemo() {
				const demo = document.querySelector<HTMLElement>('.demo');
				if (!demo) return;
				const src = demo.querySelector<HTMLElement>('[data-src]')!;
				const deps = demo.querySelectorAll<HTMLElement>('[data-dep]');
				const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[data-goto]')];
				const phoneLabel = demo.querySelector<HTMLElement>('[data-phone-label]')!;
				const files = demo.querySelector<HTMLElement>('.demo-files')!;
				const links = [...demo.querySelectorAll<SVGPathElement>('.links .curve')];
				const halos = [...demo.querySelectorAll<SVGPathElement>('.links .halo')];
				const mask = demo.querySelector<SVGMaskElement>('#links-mask')!;
				const haloMask = demo.querySelector<SVGMaskElement>('#halo-mask')!;
				const rings = [...demo.querySelectorAll<HTMLElement>('.focus-ring')];
				// How long each step stays on screen, in milliseconds. Step 3 prints three lines, so it stays longest.
				const durations = [4500, 5000, 7000, 7500];
				let timer = 0;
				let typing: number[] = [];
				// What the rings mark: the step's number, or `4-commit` once step 4 commits the fixed files.
				let focus = '3';
				let playing = false;

				const show = (step: number, animate: boolean) => {
					clearTimeout(timer);
					typing.forEach(clearTimeout);
					typing = [];
					for (const value of [src, ...deps]) delete value.dataset.typing;
					demo.dataset.step = String(step);
					demo.toggleAttribute('data-playing', playing);
					phoneLabel.textContent = tabs[step - 1].querySelector('.tab-label')!.textContent;
					demo.style.setProperty('--step-time', `${durations[step - 1]}ms`);
					for (const [i, tab] of tabs.entries()) {
						if (i === step - 1) tab.setAttribute('aria-current', 'step');
						else tab.removeAttribute('aria-current');
						tab.toggleAttribute('data-done', i < step - 1);
					}
					for (const dep of deps) dep.textContent = step === 4 ? '9090' : '8080';
					src.textContent = step === 1 ? '8080' : '9090';
					if (animate && step === 2) {
						type(src, 600);
					}
					focus = step === 4 && !animate ? '4-commit' : String(step);
					if (animate && step === 4) {
						deps.forEach((dep, i) => type(dep, 600 + i * 1900));
						// The commit runs once both values are typed, at the time the CSS shows it.
						typing.push(
							window.setTimeout(() => {
								focus = '4-commit';
								placeRings();
							}, 4300),
						);
					}
					placeRings();
					update();
					if (playing) {
						timer = window.setTimeout(() => show((step % 4) + 1, true), durations[step - 1]);
					}
				};

				/**
				 * Draws a curve from the value in settings.py to each value that must match it. Each curve has a gap
				 * wherever it passes over text, so the code stays readable. Everything is measured from the page, so the
				 * curves follow the values at any width and font.
				 */
				const drawLinks = () => {
					const box = files.getBoundingClientRect();
					const from = src.getBoundingClientRect();
					const x1 = from.right - box.left + 4;
					const y1 = from.top + from.height / 2 - box.top;
					deps.forEach((dep, i) => {
						const to = dep.getBoundingClientRect();
						const y2 = to.top + to.height / 2 - box.top;
						let d;
						if (to.left > from.right) {
							// Side by side: leave the right edge of the value and enter the left edge of the other one.
							const x2 = to.left - box.left - 4;
							const bend = (x2 - x1) / 2;
							d = `M${x1},${y1} C${x1 + bend},${y1} ${x2 - bend},${y2} ${x2},${y2}`;
						} else {
							// Stacked on a phone: loop out to the right, where the code lines are short. The second curve
							// loops wider, so the two don't overlap.
							const x2 = to.right - box.left + 4;
							const out = Math.min(Math.max(x1, x2) + 60 + i * 50, box.width - 8);
							d = `M${x1},${y1} C${out},${y1} ${out},${y2} ${x2},${y2}`;
						}
						links[i].setAttribute('d', d);
						halos[i].setAttribute('d', d);
					});

					// The mask shows the curves everywhere except over a box around each piece of text in the files.
					// A range around each text node, not each element, so only the glyphs get a hole, not a whole code box.
					const holes: DOMRect[] = [];
					const walker = document.createTreeWalker(files, NodeFilter.SHOW_TEXT);
					while (walker.nextNode()) {
						const range = document.createRange();
						range.selectNodeContents(walker.currentNode);
						holes.push(...[...range.getClientRects()].filter((rect) => rect.width > 0));
					}
					// Each curve has a wide halo in the background color under it, which hides a ring's border where the
					// curve crosses it. The halo only shows along the ring borders, so it never covers a file or its text.
					const bands = rings
						.filter((ring) => !ring.classList.contains('hidden'))
						.map((ring) => {
							const rect = ring.getBoundingClientRect();
							const band = maskRect(rect.left - box.left, rect.top - box.top, rect.width, rect.height, 'none');
							band.setAttribute('stroke', 'white');
							band.setAttribute('stroke-width', '6');
							band.setAttribute('rx', getComputedStyle(ring).borderTopLeftRadius);
							return band;
						});
					haloMask.replaceChildren(...bands);
					mask.replaceChildren(
						maskRect(-box.width, -box.height, box.width * 3, box.height * 3, 'white'),
						// A glyph box is shorter than its line, so each hole also covers the gap to the lines above and below.
						...holes.map((rect) =>
							maskRect(rect.left - box.left - 3, rect.top - box.top - 3, rect.width + 6, rect.height + 6, 'black'),
						),
					);
				};
				const maskRect = (x: number, y: number, width: number, height: number, fill: string) => {
					const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
					for (const [name, value] of Object.entries({ x, y, width, height, fill })) {
						rect.setAttribute(name, String(value));
					}
					return rect;
				};
				/**
				 * Puts a ring around each part of the demo where the current step happens: every part whose
				 * `data-focus` lists `focus`, in page order. The first ring moves from step to step, animated in CSS,
				 * so the eye can follow it. With `jump`, the rings move without the animation, for a change that isn't
				 * a step, such as a resize. A ring with no part on this step fades out where it is.
				 */
				const placeRings = (jump = false) => {
					const box = files.getBoundingClientRect();
					const targets = [...files.querySelectorAll<HTMLElement>(`[data-focus~="${focus}"]`)];
					rings.forEach((ring, i) => {
						ring.classList.toggle('hidden', !targets[i]);
						if (!targets[i]) return;
						const rect = targets[i].getBoundingClientRect();
						// The first placement jumps too. Otherwise the ring would fly in from the corner.
						const first = jump || !ring.style.width;
						if (first) ring.style.transition = 'none';
						Object.assign(ring.style, {
							left: `${rect.left - box.left - 4}px`,
							top: `${rect.top - box.top - 4}px`,
							width: `${rect.width + 8}px`,
							height: `${rect.height + 8}px`,
						});
						if (first) {
							ring.getBoundingClientRect();
							ring.style.transition = '';
						}
					});
					// The gaps in the curves follow the rings while they slide, which takes 0.6 seconds in CSS.
					const start = performance.now();
					const follow = () => {
						drawLinks();
						if (performance.now() - start < 700) requestAnimationFrame(follow);
					};
					requestAnimationFrame(follow);
				};
				new ResizeObserver(() => {
					placeRings(true);
					drawLinks();
				}).observe(files);
				document.fonts.ready.then(drawLinks);

				/**
				 * Retypes `value` from 8080 to 9090, one key at a time, starting `delay` milliseconds from now. A caret
				 * shows after the value while it is typed.
				 */
				const type = (value: HTMLElement, delay: number) => {
					const frames = ['808', '80', '8', '', '9', '90', '909', '9090'];
					value.textContent = '8080';
					typing.push(window.setTimeout(() => (value.dataset.typing = ''), delay));
					frames.forEach((frame, i) => {
						typing.push(
							window.setTimeout(() => {
								value.textContent = frame;
								if (i === frames.length - 1) delete value.dataset.typing;
								update();
							}, delay + 300 + i * 200),
						);
					});
				};

				/**
				 * Marks each dependent value and its curve as matching the value in settings.py or not, then redraws the
				 * curves. Step 1 marks nothing, so both show in the accent color.
				 */
				const update = () => {
					deps.forEach((dep, i) => {
						const state = demo.dataset.step === '1' ? null : dep.textContent === src.textContent ? 'good' : 'bad';
						for (const element of [dep, links[i]]) {
							if (state) element.dataset.state = state;
							else delete element.dataset.state;
						}
					});
					drawLinks();
				};

				const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
				for (const tab of tabs) {
					tab.addEventListener('click', () => {
						playing = false;
						show(Number(tab.dataset.goto), !reducedMotion);
					});
				}

				show(3, false);
				if (reducedMotion) return;
				const observer = new IntersectionObserver((entries) => {
					if (entries.some((entry) => entry.isIntersecting)) {
						observer.disconnect();
						playing = true;
						show(1, true);
						// The page started on step 3, which nobody has watched yet, so the ring has nothing to move from.
						placeRings(true);
					}
				});
				observer.observe(demo);
			}
		</script>
	</body>
</html>

